<!DOCTYPE html>
<html lang="en" data-resolution="landscape">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=1920, height=1080">
    <title>OpsFlow — feature tour</title>
    <script src="assets/gsap.min.js"></script>
    <script src="assets/audio-data.js"></script>
    <style>
      @font-face {
        font-family: 'Cormorant Garamond';
        font-weight: 600;
        font-style: normal;
        src: url('assets/fonts/cormorant-garamond-latin-600-normal.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Cormorant Garamond';
        font-weight: 700;
        font-style: normal;
        src: url('assets/fonts/cormorant-garamond-latin-700-normal.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Inter Variable';
        font-weight: 100 900;
        font-style: normal;
        src: url('assets/fonts/inter-latin-wght-normal.woff2') format('woff2');
      }

      :root {
        --navy-950: #05070f;
        --navy-900: #0a0f1f;
        --navy-850: #0e152b;
        --navy-800: #131c38;
        --navy-700: #1b2850;
        --navy-600: #26376b;
        --line-soft: rgb(255 255 255 / 0.08);
        --line: rgb(155 180 255 / 0.18);
        --line-strong: rgb(155 180 255 / 0.34);
        --cobalt-600: #2b4a9e;
        --cobalt-500: #3a63c8;
        --cobalt-400: #5b84e6;
        --cream-50: #fbf6ec;
        --cream-100: #f3e8d6;
        --cream-200: #e7d5b8;
        --muted: #a9b4d0;
        --subtle: #8a93ae;
        --gold-400: #e8b75a;
        --gold-300: #f2ce7e;
        --peach: #f0b98e;
        --verdigris: #79d3a6;
        --coral: #ff8f82;
        --running: #7fb0ff;
        --on-gold: #05070f;
        --font-display: 'Cormorant Garamond', Georgia, serif;
        --font-sans: 'Inter Variable', Inter, system-ui, sans-serif;
        --font-mono: ui-monospace, 'SF Mono', Menlo, monospace;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      html,
      body {
        width: 1920px;
        height: 1080px;
        overflow: hidden;
        background: var(--navy-950);
        color: var(--cream-50);
        font-family: var(--font-sans);
        -webkit-font-smoothing: antialiased;
      }
      #root {
        position: relative;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: var(--navy-950);
      }
      .clip {
        position: absolute;
        inset: 0;
        overflow: hidden;
      }
      .scene {
        position: absolute;
        inset: 0;
      }

      /* ---------- painted sky (hook + outro) ---------- */
      .sky {
        position: absolute;
        inset: -80px;
      }
      .sky svg {
        width: 100%;
        height: 100%;
        display: block;
      }
      .sky-shade {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgb(5 7 15 / 0.3) 0%, rgb(5 7 15 / 0.55) 55%, rgb(10 15 31 / 0.9) 100%);
      }
      .sky-shade.deep {
        background: linear-gradient(180deg, rgb(5 7 15 / 0.55) 0%, rgb(5 7 15 / 0.72) 55%, rgb(10 15 31 / 0.95) 100%);
      }
      .sky-hairline {
        position: absolute;
        inset: 28px;
        border: 1.5px solid rgb(251 246 236 / 0.14);
        border-radius: 2px;
      }
      .title-glow {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 1400px;
        height: 520px;
        margin-left: -700px;
        margin-top: -260px;
        border-radius: 50%;
        background: radial-gradient(ellipse at center, rgb(232 183 90 / 0.24) 0%, rgb(251 246 236 / 0.09) 35%, transparent 70%);
        opacity: 0.4;
      }
      .hero-copy {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 26px;
        text-align: center;
        padding: 0 160px;
      }
      .hero-line {
        font-family: var(--font-display);
        font-weight: 600;
        color: var(--cream-50);
        text-shadow:
          0 0 24px rgb(251 246 236 / 0.28),
          0 0 72px rgb(232 183 90 / 0.18);
        letter-spacing: 0.02em;
        line-height: 1.05;
      }
      #hook-1 {
        font-size: 104px;
      }
      #hook-2 {
        font-size: 66px;
        color: var(--cream-200);
      }
      #outro-title {
        font-size: 176px;
        font-weight: 700;
        letter-spacing: 0.03em;
      }
      #outro-tag {
        font-size: 52px;
        color: var(--cream-200);
        max-width: 1500px;
      }
      #outro-eyebrow {
        margin-top: 30px;
        font-family: var(--font-sans);
        font-size: 19px;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--muted);
      }

      /* ---------- app shell ---------- */
      .shell {
        position: absolute;
        inset: 0;
        background: var(--navy-900);
        display: grid;
        grid-template-rows: 64px 1fr;
        grid-template-columns: 280px 1fr 420px;
        grid-template-areas:
          'top top top'
          'palette canvas side';
      }
      .topbar {
        grid-area: top;
        background: var(--navy-850);
        border-bottom: 1px solid var(--line-soft);
        display: flex;
        align-items: center;
        padding: 0 24px;
        gap: 14px;
        position: relative;
      }
      .wordmark {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 32px;
        color: var(--cream-50);
        letter-spacing: 0.02em;
        line-height: 1;
        margin-right: 6px;
      }
      .topbar .divider {
        width: 1px;
        height: 28px;
        background: var(--line);
      }
      .doc-name {
        font-size: 20px;
        font-weight: 500;
        color: var(--cream-100);
        margin-left: 6px;
      }
      .topbar .spacer {
        flex: 1;
      }
      .chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        height: 30px;
        padding: 0 12px;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: var(--navy-800);
        font-size: 15px;
        font-weight: 500;
        color: var(--muted);
        white-space: nowrap;
      }
      .chip .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--verdigris);
        flex: none;
      }
      .chip.coral {
        color: var(--coral);
        border-color: rgb(255 143 130 / 0.4);
      }
      .chip.coral .dot {
        background: var(--coral);
      }
      .valid-stack {
        position: relative;
        width: 292px;
        height: 30px;
      }
      .valid-stack .chip {
        position: absolute;
        right: 0;
        top: 0;
      }
      .saved-stack {
        position: relative;
        width: 140px;
        height: 30px;
      }
      .saved-stack .chip {
        position: absolute;
        right: 0;
        top: 0;
      }
      .ghost-btn {
        height: 34px;
        padding: 0 14px;
        border-radius: 6px;
        border: 1px solid var(--line);
        color: var(--cream-200);
        font-size: 15px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
      }
      .btn-run {
        width: 124px;
        height: 40px;
        border-radius: 6px;
        background: var(--cobalt-600);
        color: var(--cream-50);
        font-size: 17px;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-left: 6px;
      }
      .btn-run .tri {
        width: 0;
        height: 0;
        border-left: 11px solid var(--cream-50);
        border-top: 7px solid transparent;
        border-bottom: 7px solid transparent;
      }

      .panel {
        background: var(--navy-850);
        position: relative;
        overflow: hidden;
      }
      .panel::after {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: radial-gradient(120% 80% at 50% 120%, rgb(243 232 214 / 0.05), transparent);
      }
      .palette {
        grid-area: palette;
        border-right: 1px solid var(--line-soft);
        padding: 0 20px;
      }
      .side {
        grid-area: side;
        border-left: 1px solid var(--line-soft);
        padding: 0 20px;
      }
      .panel-head {
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid var(--line-soft);
        margin-bottom: 14px;
      }
      .eyebrow {
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .palette-hint {
        font-size: 16px;
        line-height: 1.45;
        color: var(--muted);
        margin-bottom: 16px;
      }
      .pcard {
        position: relative;
        display: grid;
        grid-template-columns: 28px 1fr;
        column-gap: 12px;
        padding: 14px 14px;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: var(--navy-800);
        margin-bottom: 10px;
      }
      .pcard .hl {
        position: absolute;
        inset: -1px;
        border-radius: 11px;
        border: 1.5px solid var(--accent);
        box-shadow: 0 0 22px color-mix(in srgb, var(--accent) 35%, transparent);
        opacity: 0;
      }
      .pcard .ico {
        width: 22px;
        height: 22px;
        margin-top: 1px;
      }
      .pcard .lbl {
        font-size: 18px;
        font-weight: 600;
        color: var(--cream-100);
        line-height: 1.2;
      }
      .pcard .desc {
        grid-column: 2;
        font-size: 15px;
        line-height: 1.4;
        color: var(--muted);
        margin-top: 4px;
      }

      /* side panel: tabs */
      .tabs {
        display: flex;
        gap: 22px;
        height: 52px;
        align-items: stretch;
        border-bottom: 1px solid var(--line-soft);
      }
      .tab {
        position: relative;
        display: flex;
        align-items: center;
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--subtle);
      }
      .tab .ul {
        position: absolute;
        left: 0;
        right: 0;
        bottom: -1px;
        height: 2px;
        background: var(--gold-400);
        opacity: 0;
      }
      .tab.on {
        color: var(--cream-100);
      }
      .view {
        position: absolute;
        left: 20px;
        right: 20px;
        top: 66px;
        bottom: 0;
        opacity: 0;
      }
      .insp-empty {
        padding-top: 120px;
        text-align: center;
      }
      .insp-empty .t {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 34px;
        color: var(--cream-50);
        margin-bottom: 10px;
      }
      .insp-empty .b {
        font-size: 16px;
        line-height: 1.5;
        color: var(--muted);
        max-width: 320px;
        margin: 0 auto 18px;
      }
      .insp-empty .h {
        font-size: 14px;
        color: var(--subtle);
      }
      .field {
        margin-bottom: 14px;
      }
      .field .lab {
        font-size: 14.5px;
        font-weight: 500;
        letter-spacing: 0.01em;
        color: var(--cream-200);
        margin-bottom: 6px;
      }
      .field .inp {
        height: 40px;
        border-radius: 6px;
        border: 1px solid var(--line);
        background: var(--navy-800);
        color: var(--cream-50);
        font-size: 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 12px;
      }
      .field .inp .unit {
        color: var(--subtle);
        font-size: 14px;
      }
      .field .inp .caret {
        color: var(--subtle);
        font-size: 13px;
      }
      .field .help {
        font-size: 13.5px;
        line-height: 1.4;
        color: var(--subtle);
        margin-top: 6px;
      }
      .toggle-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 44px;
      }
      .toggle {
        position: relative;
        width: 44px;
        height: 24px;
        border-radius: 999px;
        background: var(--navy-600);
        flex: none;
      }
      .toggle .fillon {
        position: absolute;
        inset: 0;
        border-radius: 999px;
        background: var(--gold-400);
        opacity: 0;
      }
      .toggle .knob {
        position: absolute;
        left: 2px;
        top: 2px;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: var(--cream-50);
      }
      .insp-foot {
        display: flex;
        justify-content: space-between;
        margin-top: 10px;
        padding-top: 14px;
        border-top: 1px solid var(--line-soft);
      }
      .insp-foot .b {
        height: 36px;
        padding: 0 14px;
        border-radius: 6px;
        border: 1px solid var(--line);
        display: flex;
        align-items: center;
        font-size: 15px;
        font-weight: 500;
        color: var(--cream-200);
      }
      .insp-foot .b.danger {
        color: var(--coral);
        border-color: rgb(255 143 130 / 0.5);
      }

      /* run view */
      .run-col {
        display: flex;
        flex-direction: column;
        height: 100%;
      }
      .status-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 30px;
        margin-bottom: 12px;
      }
      .status-stack {
        position: relative;
        height: 30px;
        width: 210px;
      }
      .status-stack .chip {
        position: absolute;
        right: 0;
        top: 0;
        opacity: 0;
      }
      .status-stack .chip.gold {
        color: var(--gold-300);
        border-color: rgb(232 183 90 / 0.4);
      }
      .status-stack .chip.gold .dot {
        background: var(--gold-400);
      }
      .status-stack .chip.blue .dot {
        background: var(--running);
      }
      .status-stack .chip.idle .dot {
        background: var(--subtle);
      }
      .issues {
        position: relative;
        height: 84px;
        margin-bottom: 12px;
      }
      .issue-card {
        position: absolute;
        inset: 0;
        border-radius: 8px;
        border: 1px solid rgb(255 143 130 / 0.45);
        background: var(--navy-800);
        padding: 10px 12px;
        display: grid;
        grid-template-columns: 10px 1fr;
        column-gap: 10px;
        align-items: start;
        opacity: 0;
      }
      .issue-card .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--coral);
        margin-top: 6px;
      }
      .issue-card .t {
        font-size: 15px;
        font-weight: 600;
        color: var(--cream-50);
      }
      .issue-card .m {
        font-size: 14px;
        line-height: 1.35;
        color: var(--muted);
        margin-top: 2px;
      }
      .issue-ok {
        position: absolute;
        inset: 0;
        border-radius: 8px;
        border: 1px solid rgb(121 211 166 / 0.35);
        background: var(--navy-800);
        padding: 0 12px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 15px;
        color: var(--cream-200);
        opacity: 0;
      }
      .issue-ok .ck {
        color: var(--verdigris);
        font-weight: 700;
      }
      .presets {
        display: flex;
        gap: 8px;
        margin-bottom: 12px;
        flex-wrap: nowrap;
        overflow: hidden;
      }
      .preset {
        height: 30px;
        padding: 0 11px;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: var(--navy-800);
        font-size: 13.5px;
        font-weight: 500;
        color: var(--muted);
        display: flex;
        align-items: center;
        white-space: nowrap;
      }
      .preset.sel {
        color: var(--on-gold);
        background: var(--gold-400);
        border-color: var(--gold-400);
        font-weight: 600;
      }
      .payload {
        border: 1px solid var(--line);
        border-radius: 10px;
        background: var(--navy-800);
        padding: 12px 14px 14px;
        margin-bottom: 12px;
      }
      .payload .prow {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2px;
      }
      .payload .ptitle {
        font-size: 15px;
        font-weight: 600;
        color: var(--cream-200);
      }
      .payload .pjson {
        font-size: 13px;
        color: var(--cobalt-400);
        font-weight: 500;
      }
      .payload .pmain {
        font-size: 17px;
        font-weight: 500;
        color: var(--cream-50);
        line-height: 1.3;
        margin-bottom: 10px;
      }
      .pgrid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 8px 12px;
      }
      .pf .k {
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--subtle);
        margin-bottom: 1px;
      }
      .pf .v {
        font-size: 14.5px;
        color: var(--cream-200);
        font-family: var(--font-mono);
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
      }
      .pf .v.crit {
        color: var(--coral);
        font-weight: 600;
      }
      .player {
        display: flex;
        align-items: center;
        gap: 8px;
        height: 40px;
        margin-bottom: 10px;
      }
      .pbtn {
        height: 34px;
        padding: 0 12px;
        border-radius: 6px;
        border: 1px solid var(--line);
        background: var(--navy-800);
        color: var(--cream-200);
        font-size: 14px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
      }
      .pbtn.primary {
        background: var(--cobalt-600);
        color: var(--cream-50);
        border-color: var(--cobalt-600);
      }
      .player .spacer {
        flex: 1;
      }
      .seg {
        display: flex;
        border: 1px solid var(--line);
        border-radius: 6px;
        overflow: hidden;
        height: 34px;
      }
      .seg span {
        position: relative;
        padding: 0 11px;
        display: flex;
        align-items: center;
        font-size: 14px;
        font-weight: 500;
        color: var(--muted);
        background: var(--navy-800);
        border-right: 1px solid var(--line);
        white-space: nowrap;
      }
      .seg span:last-child {
        border-right: 0;
      }
      .seg span.on {
        color: var(--cream-50);
      }
      .seg span.on::after {
        content: '';
        position: absolute;
        left: 8px;
        right: 8px;
        bottom: 3px;
        height: 2px;
        background: var(--gold-400);
      }
      .tl-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 30px;
        margin-bottom: 4px;
      }
      .tl-wrap {
        position: relative;
        flex: 1;
        overflow: hidden;
      }
      .tl-empty {
        position: absolute;
        font-size: 15px;
        color: var(--subtle);
        line-height: 1.4;
      }
      .summary {
        position: relative;
        border-top: 1px solid rgb(121 211 166 / 0.6);
        border-radius: 8px;
        background: var(--navy-800);
        padding: 10px 14px;
        margin-bottom: 8px;
        opacity: 0;
        min-height: 74px;
      }
      .summary .s1 {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 24px;
        color: var(--cream-50);
        line-height: 1.15;
      }
      .summary .s2 {
        font-size: 13px;
        color: var(--muted);
        margin-top: 4px;
        font-family: var(--font-mono);
      }
      .rows {
        display: flex;
        flex-direction: column;
      }
      .row {
        position: relative;
        display: grid;
        grid-template-columns: 54px 20px 1fr;
        column-gap: 8px;
        align-items: start;
        padding: 6px 6px 6px 4px;
        border-bottom: 1px solid var(--line-soft);
        opacity: 0;
        border-radius: 6px;
      }
      .row .hover {
        position: absolute;
        inset: 0;
        border-radius: 6px;
        background: var(--navy-700);
        opacity: 0;
      }
      .row > span {
        position: relative;
      }
      .row .t {
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--muted);
        padding-top: 2px;
        font-variant-numeric: tabular-nums;
      }
      .row .g {
        font-size: 14px;
        line-height: 19px;
        text-align: center;
        font-weight: 700;
      }
      .row .m {
        font-size: 14.5px;
        line-height: 1.32;
        color: var(--cream-200);
      }
      .row .m b {
        color: var(--cream-50);
        font-weight: 500;
      }
      .row .badge {
        display: inline-block;
        margin-left: 8px;
        padding: 1px 7px;
        border-radius: 4px;
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: 0.08em;
        background: var(--navy-900);
        color: var(--verdigris);
        vertical-align: 1px;
      }
      .g.g-run {
        color: var(--running);
      }
      .g.ok {
        color: var(--verdigris);
      }
      .g.wait {
        color: var(--gold-300);
      }
      .g.br {
        color: var(--cobalt-400);
      }

      /* canvas */
      .canvas {
        grid-area: canvas;
        position: relative;
        overflow: hidden;
        background: var(--navy-900);
      }
      .impasto {
        position: absolute;
        inset: 0;
        background:
